{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juanola",
  "version": "0.1.0",
  "identifier": "dev.juanola.desktop",
  "build": {
    "beforeDevCommand": "scripts/build-sidecar.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "scripts/build-sidecar.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Juanola",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    },
    "externalBin": [
      "binaries/juanola-stt-worker"
    ]
  }
}
