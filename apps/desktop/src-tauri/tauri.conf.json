{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juanola",
  "version": "0.0.1",
  "identifier": "dev.juanola.desktop",
  "build": {
    "beforeDevCommand": "scripts/build-sidecar.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "scripts/build-sidecar.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Juanola",
        "label": "main",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "locales/es.lproj/InfoPlist.strings"
      },
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 468 },
        "appPosition": { "x": 165, "y": 215 },
        "applicationFolderPosition": { "x": 495, "y": 215 }
      }
    },
    "externalBin": [
      "binaries/juanola-stt-worker"
    ]
  }
}
